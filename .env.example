# Local / Vercel server env — never commit real values.
# Do not prefix these with NEXT_PUBLIC_ and do not put them in HTML.

# Airbnb listing iCal URL (server-only). Used by sync-airbnb-ical.
AIRBNB_ICAL_URL=

# Shared secret so Vercel Cron / pg_cron can invoke sync + expiry functions.
CRON_SECRET=

# Already public on the site; Vercel cron uses this to invoke Edge Functions.
SUPABASE_URL=https://rywomhsgcaighcwnftoa.supabase.co
SUPABASE_ANON_KEY=

# Vercel Cron on Hobby is daily (vercel.json). Hourly needs Pro.
# Do not set AIRBNB_ICAL_URL on Vercel.

# Email: reuse whichever secrets send-booking-email already has.
# Typical: RESEND_API_KEY (do not add a new ESP).
# RESEND_API_KEY=
# EMAIL_FROM=The Skylark <hello@skylarkbenton.com>
